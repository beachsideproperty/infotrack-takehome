# Copy to .env for docker compose (`cp .env.example .env`). Never commit .env.
# Without Docker, set API secrets with `dotnet user-secrets` (see README) and web vars in web/.env.local.

# ---- API (Render env vars in production) ----
# Gemini key from https://aistudio.google.com/app/apikey (used from phase 2).
GEMINI_API_KEY=
# Sent in Open Library's User-Agent so we get the 3 req/s limit (used from phase 2).
OPENLIBRARY_CONTACT_EMAIL=
# Comma-separated browser origins allowed by CORS. No trailing slash.
# Production: your Vercel URL, e.g. https://infotrack-takehome.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
# Port the API listens on (0.0.0.0). Render sets this itself (default 10000). Unset locally → 8080 via launchSettings.
PORT=

# ---- Web (Vercel env vars in production; baked in at build time, never put secrets here) ----
VITE_API_URL=http://localhost:8080
