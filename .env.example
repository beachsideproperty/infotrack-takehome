# Copy to .env for docker compose (`cp .env.example .env`). Never commit .env.
# Without Docker, set API secrets with `dotnet user-secrets` (see README) and web vars in web/.env.local.

# ---- API (Render env vars in production) ----
# Gemini key from https://aistudio.google.com/app/apikey. Without it, the API still works using the
# rule-based parser and template explanations (responses say "parser": "fallback").
GEMINI_API_KEY=
# Optional model overrides (defaults: gemini-3.5-flash-lite, then gemini-3.1-flash-lite).
# Parsing tries GEMINI_MODEL first, explanations try GEMINI_FALLBACK_MODEL first, to spread free-tier quota.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Our own cap per model, kept under Google's free-tier limit (15/min for Flash-Lite). Default 14.
GEMINI_RPM_PER_MODEL=
# Sent in Open Library's User-Agent so we get the 3 req/s limit (1 req/s without it).
OPENLIBRARY_CONTACT_EMAIL=
# Searches allowed per client IP per minute before a 429 "Lots of searches at once". Default 10.
SEARCH_RATE_LIMIT_PER_MINUTE=
# Comma-separated browser origins allowed by CORS. No trailing slash.
# Production: your Vercel URL, e.g. https://infotrack-takehome.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
# Port the API listens on (0.0.0.0). Render sets this itself (default 10000). Unset locally → 8080 via launchSettings.
PORT=

# ---- Web (Vercel env vars in production; baked in at build time, never put secrets here) ----
VITE_API_URL=http://localhost:8080
